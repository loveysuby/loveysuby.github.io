---
interface Props {
  class?: string
  /** Discussion key. Shared by every language version of a post. */
  term: string
}

const { class: className, term } = Astro.props
---

<section class={className} id='giscus-container'>
  <script
    is:inline
    src='https://giscus.app/client.js'
    data-repo='loveysuby/loveysuby.github.io'
    data-repo-id='MDEwOlJlcG9zaXRvcnkzNjA0ODA1MTU='
    data-category='General'
    data-category-id='DIC_kwDOFXx_A84C5Nfm'
    data-mapping='specific'
    data-term={term}
    data-strict='0'
    data-reactions-enabled='1'
    data-emit-metadata='0'
    data-input-position='bottom'
    data-theme='preferred_color_scheme'
    data-lang='en'
    data-loading='lazy'
    crossorigin='anonymous'
    async></script>
</section>

<script is:inline>
  // Keep the giscus iframe in sync with the site's light/dark class.
  {
    const theme = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light')
    const send = () =>
      document
        .querySelector('iframe.giscus-frame')
        ?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app')
    window.addEventListener('message', (e) => e.origin === 'https://giscus.app' && send(), { once: true })
    new MutationObserver(send).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
  }
</script>
