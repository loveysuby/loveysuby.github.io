---
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import SearchBar from '@/components/home/SearchBar.astro'
import { LANG_KEYS, postsByLang } from '@/utils/posts'

// Shared by `/` and `/blog/[page]`.
interface Props {
  posts: CollectionEntry<'blog'>[]
  uniqueTags: string[]
  prevUrl?: string
  nextUrl?: string
}

const { posts, uniqueTags, prevUrl, nextUrl } = Astro.props

const variants = await postsByLang(posts)

const paginationProps = {
  ...(prevUrl && { prevUrl: { text: `← Previous Posts`, url: prevUrl } }),
  ...(nextUrl && { nextUrl: { text: `Next Posts →`, url: nextUrl } })
}
---

<main class='mt-6 grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8 lg:mt-10'>
  <section aria-label='Posts list' class='animate' id='content'>
    <h1 class='mb-4 text-lg font-medium'>Posts</h1>
    {
      posts.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <>
          {LANG_KEYS.map((lang) => (
            <ul class='flex flex-col gap-y-4 text-start' data-lang-only={lang}>
              {variants[lang].map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
          ))}
          <Paginator {...paginationProps} />
        </>
      )
    }
  </section>

  <!-- sm:pt-11 (44px) = Posts h1 line-height 28px + mb-4 16px, so the sidebar starts level with the first post card. -->
  <aside class='animate flex flex-col gap-y-8 sm:pt-11' id='sidebar'>
    <SearchBar />

    {
      !!uniqueTags.length && (
        <div>
          <h2 class='mb-4 flex items-center text-lg font-medium'>
            <Icon name='tag-2' class='me-2' />
            Tags
          </h2>
          <ul class='text-bgColor flex flex-wrap gap-2'>
            {
              // Only show top 50 tags in sidebar
              uniqueTags.slice(0, 50).map((tag) => (
                <li>
                  <Button title={tag} href={`/tags/${tag}`} variant='pill' />
                </li>
              ))
            }
          </ul>
        </div>
      )
    }

    <div class='flex flex-col gap-y-1 text-sm sm:text-end'>
      {
        !!uniqueTags.length && (
          <a aria-label='View all tags' href='/tags' data-astro-prefetch>
            All tags →
          </a>
        )
      }
      <a aria-label='View all posts by year' href='/archives' data-astro-prefetch>By year →</a>
    </div>
  </aside>
</main>
