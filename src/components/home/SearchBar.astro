---
import { Icon } from 'astro-pure/user'
---

<form action='/search' method='get' role='search'>
  <label
    class='flex items-center gap-x-2 rounded-xl border bg-muted/50 px-3 py-2 transition-colors focus-within:border-primary/50'
  >
    <Icon name='search' class='size-5 shrink-0 text-muted-foreground' />
    <span class='sr-only'>Search posts</span>
    <input
      data-search-input
      name='q'
      type='search'
      placeholder='Search'
      autocomplete='off'
      class='w-full min-w-0 bg-transparent outline-none placeholder:text-muted-foreground'
    />
    <kbd
      data-search-hint
      class='hidden shrink-0 rounded border px-1.5 py-0.5 font-sans text-xs text-muted-foreground lg:inline'
      >Ctrl K</kbd
    >
  </label>
</form>
