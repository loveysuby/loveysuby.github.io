---
import type { MarkdownHeading } from 'astro'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Hero, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import Copyright from '@/components/Copyright.astro'
import Giscus from '@/components/Giscus.astro'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { DEFAULT_LANG, HTML_LANG, type getTranslations, type LocalizedPost } from '@/utils/posts'
import config from 'virtual:config'

interface Props {
  post: LocalizedPost
  posts: LocalizedPost[]
  translations: Awaited<ReturnType<typeof getTranslations>>
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, lang, slug },
  posts,
  translations,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
  lang={HTML_LANG[lang]}
  pageLang={lang}
  {translations}
>
  <Fragment slot='head'>
    {
      translations.length > 1 &&
        translations.map((t) => (
          <link rel='alternate' hreflang={HTML_LANG[t.lang]} href={new URL(t.href, Astro.site)} />
        ))
    }
    {
      translations.length > 1 && (
        <link
          rel='alternate'
          hreflang='x-default'
          href={new URL((translations.find((t) => t.lang === DEFAULT_LANG) ?? translations[0]).href, Astro.site)}
        />
      )
    }
  </Fragment>

  {!!headings.length && <TOC {headings} slot='sidebar' />}

  {/* heroImage is used for the list cards and the link preview only, not shown on the post itself */}
  <Hero data={{ ...data, heroImage: undefined }} {remarkPluginFrontmatter} slot='header'>
    <LanguageSwitcher slot='description' current={lang} {translations} />
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {/* Comment */}
    {!isDraft && enableComment && <Giscus class='mt-3 sm:mt-6' term={`blog/${slug}`} />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}
