---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import { DEFAULT_LANG, LANG_KEYS, type Lang } from '@/utils/posts'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  /** Value for `<html lang>`. Defaults to the site locale. */
  lang?: string
  /** Set on pages written in one language (posts). The language menu then shows this language. */
  pageLang?: Lang
  /** Other languages of this page. The language menu links to them. */
  translations?: { lang: Lang; href: string }[]
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor = 'hsl(var(--primary))',
  lang = config.locale.lang,
  pageLang,
  translations,
  ...props
} = Astro.props

// `<html data-pref-lang>` holds the language the reader chose. Elements with `data-lang-only`
// are hidden unless their value equals it.
const langCss = LANG_KEYS.map(
  (l) =>
    `html[data-pref-lang='${l}'] [data-lang-only]:not([data-lang-only='${l}']){display:none!important}` +
    `html[data-pref-lang='${l}'] lang-menu [data-lang-option='${l}']{color:hsl(var(--primary));font-weight:500}`
).join('')
---

<html {lang} data-pref-lang={pageLang ?? DEFAULT_LANG} data-page-lang={pageLang}>
  <head>
    <style is:inline set:html={langCss}></style>
    <script is:inline define:vars={{ langs: LANG_KEYS }}>
      // Reader's language, kept in localStorage['lang']. Runs in <head> so that lists are shown
      // in the right language on first paint.
      const root = document.documentElement
      const pageLang = root.dataset.pageLang
      const read = () => {
        try {
          const value = localStorage.getItem('lang')
          return langs.includes(value) ? value : null
        } catch {
          return null
        }
      }
      const write = (value) => {
        try {
          localStorage.setItem('lang', value)
        } catch {}
      }
      const apply = () => {
        const pref = read()
        // A post page is shown in its own language. It sets the preference only if none exists.
        if (pageLang) {
          if (!pref) write(pageLang)
        } else if (pref) root.dataset.prefLang = pref
      }
      apply()
      // Prerendered (speculation rules) and back/forward-cached pages ran apply() earlier.
      document.addEventListener('prerenderingchange', apply)
      window.addEventListener('pageshow', apply)
      // Any element with `data-lang-option` selects a language. Links navigate afterwards.
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element && e.target.closest('[data-lang-option]')
        if (!el) return
        write(el.dataset.langOption)
        if (el.tagName !== 'A') apply()
      })
    </script>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
    <slot name='head' />
  </head>

  <body class='relative flex justify-center bg-background text-foreground' {...props}>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-full max-h-[220vh] w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div
      id='main-container'
      class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <Header {translations} />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
    <script is:inline>
      // Cmd/Ctrl+K: focus the search box on this page, or go to the search page.
      {
        const mac = /Mac|iPhone|iPad/.test(navigator.platform)
        document.querySelectorAll('[data-search-hint]').forEach((el) => {
          el.textContent = mac ? '⌘K' : 'Ctrl K'
        })
        document.addEventListener('keydown', (e) => {
          if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return
          e.preventDefault()
          const input = document.querySelector('[data-search-input], .pagefind-ui__search-input')
          if (input) {
            input.focus()
            input.select()
          } else {
            location.href = '/search'
          }
        })
      }
    </script>
  </body>
</html>
