---
import PageLayout from '@/layouts/BaseLayout.astro'
import PostGroups from '@/components/PostGroups.astro'
import {
  byCountThenName,
  getPosts,
  groupByTag,
  groupPosts,
  LANG_KEYS,
  postsByLang,
  type LocalizedPost
} from '@/utils/posts'

export const prerender = true

const posts = await getPosts()
const year = (date: Date) => date.toISOString().slice(0, 4)

type View = {
  id: string
  label: string
  dateFormat: 'month-day' | 'full'
  groups: ReturnType<typeof groupPosts>
}

const buildViews = (posts: LocalizedPost[]): View[] => [
  {
    id: 'year',
    label: 'By Year',
    dateFormat: 'month-day',
    groups: groupPosts(posts, (p) => [year(p.data.publishDate)]).sort((a, b) =>
      b.key.localeCompare(a.key)
    )
  },
  {
    id: 'category',
    label: 'By Category',
    dateFormat: 'full',
    groups: groupPosts(posts, (p) => (p.data.category ? [p.data.category] : [])).sort(
      byCountThenName
    )
  },
  { id: 'tag', label: 'By Tag', dateFormat: 'full', groups: groupByTag(posts) }
]

// Tabs come from the default-language posts. Each tab panel holds one list per language.
const views = buildViews(posts).filter((view) => view.groups.length > 0)
const variants = await postsByLang(posts)
const viewsByLang = LANG_KEYS.map((lang) => ({ lang, views: buildViews(variants[lang]) }))

const meta = {
  description: 'All posts, grouped by year, category or tag',
  title: 'Archive'
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Archive</h1>
    </div>

    {posts.length === 0 && <p>No posts yet.</p>}

    <section id='content' class='animate' aria-label='Post archive'>
      <div class='archive-tabs grid gap-1 rounded-xl border bg-muted/50 p-1' role='tablist'>
        {
          views.map((view, i) => (
            <button
              type='button'
              role='tab'
              data-view={view.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class='rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors'
            >
              {view.label}
            </button>
          ))
        }
      </div>

      {
        views.map((view, i) => (
          <div data-panel={view.id} role='tabpanel' hidden={i !== 0} class='mt-6'>
            {viewsByLang.map(({ lang, views: localized }) => (
              <div data-lang-only={lang}>
                <PostGroups
                  groups={localized.find((v) => v.id === view.id)?.groups ?? []}
                  dateFormat={view.dateFormat}
                />
              </div>
            ))}
          </div>
        ))
      }
    </section>
  </main>
</PageLayout>

<script is:inline>
  // Tabs. The selected view is kept in the URL hash (#year, #category, #tag).
  {
    const tabs = [...document.querySelectorAll('.archive-tabs [data-view]')]
    const select = (id) => {
      if (!tabs.some((t) => t.dataset.view === id)) id = tabs[0]?.dataset.view
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.view === id)))
      document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id))
    }
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        history.replaceState(null, '', '#' + t.dataset.view)
        select(t.dataset.view)
      })
    )
    select(location.hash.slice(1))
  }
</script>

<style>
  .archive-tabs {
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  }
  .archive-tabs [aria-selected='true'] {
    background-color: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    font-weight: 500;
  }
  .archive-tabs [aria-selected='false']:hover {
    color: hsl(var(--foreground));
  }
</style>
