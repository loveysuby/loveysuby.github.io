---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import BlogList from '@/components/BlogList.astro'
import { getPosts } from '@/utils/posts'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = await getPosts()
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
}

const { page, uniqueTags } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Posts'
}
---

<PageLayout {meta}>
  <BlogList posts={page.data} {uniqueTags} prevUrl={page.url.prev} nextUrl={page.url.next} />
</PageLayout>
