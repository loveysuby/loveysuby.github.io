---
import { getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import BlogList from '@/components/BlogList.astro'
import { getPosts } from '@/utils/posts'
import config from '@/site-config'

// `/` shows the same list as `/blog` (page 1).
const collections = await getPosts()
const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
// 10 is Astro's paginate() default when blogPageSize is unset.
const pageSize = config.content.blogPageSize ?? 10
const posts = collections.slice(0, pageSize)
const nextUrl = collections.length > pageSize ? '/blog/2' : undefined
---

<PageLayout meta={{ title: config.title }}>
  <BlogList {posts} {uniqueTags} {nextUrl} />
</PageLayout>
